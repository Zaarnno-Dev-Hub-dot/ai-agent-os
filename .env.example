# Copy to .env (or set in your shell). Every value is optional.

# Gateway
AGENT_OS_GATEWAY_PORT=4110
# Where the database, uploads, agent workspaces and saved agents live (default: ./data)
# AGENT_OS_GATEWAY_DATA_DIR=./data
# Comma-separated extra browser origins allowed to call the gateway API
# AGENT_OS_EXTRA_ORIGINS=
# Set to 1 to allow *.trycloudflare.com origins (remote/mobile access via a quick tunnel)
# AGENT_OS_ALLOW_TUNNEL_ORIGINS=0

# Budgets / relay
# AGENT_OS_MAX_TOKENS_PER_TURN=
# Per-agent caps as JSON, e.g. {"claude-code#review":6000}
# AGENT_OS_PER_SEAT_MAX_TOKENS_PER_TURN=
# AGENT_OS_RELAY_WINDOW=

# Optional Paperclip bridge
# PAPERCLIP_BASE_URL=http://127.0.0.1:3100

# Agent credentials are NOT read from here: each CLI (codex, claude, grok,
# cursor agent, opencode, hermes) uses its own login, and model API keys are
# entered in the dashboard's Add agent panel.
