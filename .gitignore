# Dependencies
node_modules/

# Build output (any depth — adapters nest one level deeper)
packages/**/dist/

# Runtime data — never commit chat history, agent workspaces, or the DB
data/

# Local env / secrets
.env
.env.*
!.env.example
*.local

# OS noise
Thumbs.db
Desktop.ini
.DS_Store

# Logs
*.log
logs/

.claude/

# Per-machine seat transports (endpoints, models)
config/local/

# Workshop worktrees (registered git worktrees, not content)
.workshop-worktrees/
